{
  "name": "ai-werewolf-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bash scripts/start_app.command",
    "tts": "bash scripts/start_tts_backend.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test scripts/tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && sh scripts/android-gradle.sh assembleDebug",
    "app:dev": "electron electron/main.cjs",
    "app:build": "npm run build && esbuild server/room-server.ts --bundle --platform=node --format=cjs --outfile=dist-electron/room-server.cjs && electron-builder --mac",
    "tts:venv": "bash scripts/build-tts-venv.sh",
    "mcp-bridge": "node mcp/standalone-hub.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.0.3",
    "@google/genai": "^1.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@wllama/wllama": "^3.6.1",
    "bonjour-service": "^1.3.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "jotai": "^2.15.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.werewolf.voxel",
    "productName": "方块狼人杀",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron"
      },
      {
        "from": "mcp",
        "to": "mcp"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "icon": "build/icon.icns"
    }
  },
  "main": "electron/main.cjs"
}
